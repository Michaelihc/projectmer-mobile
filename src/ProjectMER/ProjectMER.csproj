<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>ProjectMER</AssemblyName>
    <RootNamespace>ProjectMER</RootNamespace>
    <Version>2025.11.2.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- ProjectMER's code style: unannotated nullable fields and missing XML docs. -->
    <NoWarn>$(NoWarn);CS1591;CS0618;CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8629;CS8714</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
  </ItemGroup>

  <PropertyGroup>
    <LabApiProject>$(LabApiMobileRoot)\src\LabApi\LabApi.csproj</LabApiProject>
    <!-- LabApi is not in ProjectMER-Mobile.sln; without this a solution build compiles it as Debug. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(LabApiProject)" Private="false" Condition="Exists('$(LabApiProject)')" />
  </ItemGroup>

  <!-- LabApi.dll comes from a LabAPI-Mobile checkout, and the game assemblies from its extracted server. -->
  <Target Name="CheckLabApiMobile" BeforeTargets="Restore;_GenerateRestoreGraph;CollectPackageReferences;ResolveProjectReferences;BeforeBuild">
    <Error Condition="!Exists('$(LabApiProject)')"
           Text="LabAPI-Mobile not found: '$(LabApiProject)' does not exist. Clone https://github.com/Michaelihc/labapimobile next to this repo or set LabApiMobileRoot." />
    <Error Condition="!Exists('$(CarlManaged)\Assembly-CSharp.dll')"
           Text="Carl Mod server assemblies not found in '$(CarlManaged)'. Extract the server with labapimobile's tools/extract-server.py or set CarlManaged." />
  </Target>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(CarlManaged)\Assembly-CSharp.dll" Publicize="true" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(CarlManaged)\Assembly-CSharp-firstpass.dll" Publicize="true" Private="false" />
    <Reference Include="Mirror" HintPath="$(CarlManaged)\Mirror.dll" Publicize="true" Private="false" />
    <Reference Include="DigitalDust" HintPath="$(CarlManaged)\DigitalDust.dll" Publicize="true" Private="false" />
    <Reference Include="CommandSystem.Core" HintPath="$(CarlManaged)\CommandSystem.Core.dll" Private="false" />
    <Reference Include="NorthwoodLib" HintPath="$(CarlManaged)\NorthwoodLib.dll" Private="false" />
    <Reference Include="YamlDotNet" HintPath="$(CarlManaged)\YamlDotNet.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(CarlManaged)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(CarlManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(CarlManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(CarlManaged)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(CarlManaged)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(CarlManaged)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="mscorlib" HintPath="$(CarlManaged)\mscorlib.dll" Private="false" />
    <Reference Include="System" HintPath="$(CarlManaged)\System.dll" Private="false" />
    <Reference Include="System.Core" HintPath="$(CarlManaged)\System.Core.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(CarlManaged)\netstandard.dll" Private="false" />
  </ItemGroup>
</Project>
